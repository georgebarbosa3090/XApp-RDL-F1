  "scenarios": {
    "S0": {
      "ns3": "scenario_rdl_no_conflict",
      "args": [
        "--simTime=20"
      ],
      "conflict_window_s": [
        10.0,
        15.0
      ],
      "summary": "Ações independentes em gNBs distintos: não há conflito; serve de controle (pass-through).",
      "proposals": [
        {
          "xapp_id": "xslice",
          "gnb": 0,
          "parameter": "PRB_QUOTA",
          "value": 80,
          "priority": 90,
          "start": 10.0,
          "end": 10.1,
          "period": 0
        },
        {
          "xapp_id": "energy_saving",
          "gnb": 1,
          "parameter": "TX_POWER",
          "value": 30,
          "priority": 65,
          "start": 10.05,
          "end": 10.15,
          "period": 0
        }
      ]
    },
    "S1": {
