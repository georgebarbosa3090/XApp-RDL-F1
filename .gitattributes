# Scripts executados no WSL/Linux precisam de finais de linha LF
*.sh text eol=lf
# Evidência experimental: bytes preservados (hashes SHA-256 dependem disso)
experiments/runs/** -text
experiments/runs_failed/** -text
experiments/e2_dissection/** -text
experiments/xapp_logs/** -text
*.patch text eol=lf

# Código de terceiros copiado sem modificação: bytes preservados (sha256 em SOURCE.md)
third_party/** -text

# Parâmetros dos modelos de energia: sha256 conferido em scripts/certification/energy_model.py
simulations/ns3/energy/*.json text eol=lf
