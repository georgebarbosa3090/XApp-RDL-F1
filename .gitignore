# =============================================================================
# .gitignore — XApp-RDL-F1 (H-RDL)
# Regras Permanentes de Exclusão e Higienização de Repositório
# =============================================================================

# 1. Diretórios de Agentes e Skills Locais (Permanentemente Proibido)
.agents/
/agents/
!src/agents/
skills/
.system_generated/

# 2. Auditoria Técnica e Relatórios Extensos Internos (Permanentemente Proibido)
auditoria/
*relatorio_extenso*
*.audit.md
docs/relatorio_extenso*
!docs/auditoria/
!docs/auditoria/*

# 3. Artefatos de Fase 2 (Não pertencem ao repositório Fase 1)
experiments/results/rdl_phase2/
*rdl_phase2*
*phase2*
!scripts/testbed/
!scripts/testbed/*

# 4. Notebooks do Google Colab e Análises Locais
notebooks/*
!notebooks/rdl_colab_scikit_learn.ipynb
*.ipynb
!notebooks/rdl_colab_scikit_learn.ipynb
.ipynb_checkpoints/

# 5. Artigos Científicos, Papers, Fontes LaTeX / Typst e PDFs
paper/
paper_sbrc/
*.tex
*.bib
*.sty
*.cls
*.bbl
*.blg
*.aux
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.pdf
*.typ
*Dissertacao*
*dissertacao*

# docs/auditoria: PERMITE ESTRITAMENTE APENAS AUDITORIA_PROFUNDA_INTEGRAL_CONSOLIDADA_2026.md
docs/auditoria/*
!docs/auditoria/AUDITORIA_PROFUNDA_INTEGRAL_CONSOLIDADA_2026.md

# 6. Scripts Locais de Experimentos, Benchmarks, Plotagem, Backup e Sincronização
scripts/compile_dissertation*.py
*compile_dissertation*
scripts/run_multi_seed_evaluation.py
scripts/run_and_analyze_benchmarks.py
scripts/plot_ns3_benchmarks.py
scripts/evaluate_and_improve_algorithms.py
scripts/collect_evidence.sh
scripts/run_baseline_experiment.sh
scripts/run_experiment_suite.py
scripts/run_full_experiment.sh
scripts/run_rdl_experiment.sh
scripts/update_realtime_tracking_docs.py
scripts/run_3_consecutive_simulations.py
scripts/generate_sbrc_figures.py
scripts/generate_scenario_figures.py
scripts/generate_single_seed_publication_figures.py
scripts/update_colab_notebook.py
scripts/git_*.sh
scripts/git_*.ps1
scripts/fix_mermaid.py
scripts/test_batching.py
*backup*
!scripts/backup_to_google_drive.*
backups/
*rollback*
*sync*
!docs/compliance/*.md


# 7. Byte-compiled / Python Cache / DLLs / Egg-Info
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
*.egg-info
*.egg
build/
dist/

# 8. Ambientes Virtuais
.venv/
venv/
ENV/
env/

# 9. Testes e Cobertura
.pytest_cache/
.coverage
htmlcov/

# 10. Logs, Bancos de Dados e Binários Locais
*.log
!experiments/runs/certified_closed_loop_chain/*.log
*.sqlite3
wheels/

# 11. Sistema Operacional e IDEs
.DS_Store
.vscode/
.idea/
Thumbs.db

# 12. Scripts PowerShell locais de automação IDE
*.ps1

